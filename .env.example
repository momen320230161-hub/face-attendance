# Supabase project settings (backend only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=optional-jwt-secret

# Frontend configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_REDIRECT_URL=http://localhost:3000

# A secret installed on the trusted check-in device. It must be sent as X-Device-Key.
DEVICE_API_KEY=replace-with-a-long-random-secret

# Recognition settings
MATCH_THRESHOLD=0.60
DEBOUNCE_MINUTES=20
INSIGHTFACE_CTX_ID=-1
